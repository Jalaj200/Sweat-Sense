# Sweat Sense — Environment Variables Example
# Copy this file to .env for local configuration or configure these in your deployment platform (e.g. Vercel)

# Security (Required in production)
DJANGO_SECRET_KEY=change-this-to-a-secure-unpredictable-secret-key
DJANGO_DEBUG=True

# Allowed Hosts (comma-separated list)
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Optional Production Database (PostgreSQL URL when migrating away from local SQLite)
# DATABASE_URL=postgres://username:password@hostname:5432/sweat_sense_db

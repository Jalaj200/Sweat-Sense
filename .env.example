# CRPify — Production & Local Environment Variables
# Copy this file to .env for local testing or configure these in the Vercel Project Settings

# 1. Security Configuration
DJANGO_SECRET_KEY=change-this-to-a-secure-unpredictable-secret-key
DEBUG=False

# 2. Database Configuration (Target: TiDB Cloud / MySQL)
# Set these individual variables (Recommended for TiDB Cloud):
MYSQL_HOST=gateway01.us-west-2.prod.aws.tidbcloud.com
MYSQL_PORT=4000
MYSQL_USER=your_tidb_username_prefix.root
MYSQL_PASSWORD=your_tidb_password_here
MYSQL_DATABASE=test

# Alternative: Single Connection URL format
# DATABASE_URL=mysql://username:password@gateway01.us-west-2.prod.aws.tidbcloud.com:4000/test?charset=utf8mb4&ssl-mode=REQUIRED

# 3. Hostnames and Domain Routing
ALLOWED_HOSTS=sweat-sense-a6cl.vercel.app,sweat-sense.vercel.app,.vercel.app,127.0.0.1,localhost

# 4. CSRF Protection for Production Form Submissions
CSRF_TRUSTED_ORIGINS=https://sweat-sense-a6cl.vercel.app,https://sweat-sense.vercel.app,https://*.vercel.app

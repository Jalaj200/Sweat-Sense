# Sweat Sense — Production & Local Environment Variables
# Copy this file to .env for local testing or configure these in the Vercel Project Settings

# 1. Security Configuration
# In production, set to a cryptographically random string (e.g. 50+ characters)
DJANGO_SECRET_KEY=change-this-to-a-secure-unpredictable-secret-key

# Set to False in production! (Defaults to True for local development)
DEBUG=False

# 2. Database Configuration
# REQUIRED IN PRODUCTION (Vercel): Persistent PostgreSQL connection string (Neon, Supabase, etc.)
# If left empty locally, Django defaults to db.sqlite3 when DEBUG=True.
DATABASE_URL=postgres://username:password@ep-host.region.neon.tech/sweatsensedb?sslmode=require

# 3. Hostnames and Domain Routing
# Comma-separated list of allowed domains
ALLOWED_HOSTS=sweat-sense.vercel.app,.vercel.app,127.0.0.1,localhost

# 4. CSRF Protection for Production Form Submissions
# Comma-separated list of trusted HTTPS origins for POST requests (login, signup, bookings)
CSRF_TRUSTED_ORIGINS=https://sweat-sense.vercel.app,https://*.vercel.app
